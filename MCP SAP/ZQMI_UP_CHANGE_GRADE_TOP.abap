      O_MSGV2 TYPE SY-MSGV2,
      O_MSGV3 TYPE SY-MSGV3,
      O_MSGV4 TYPE SY-MSGV4,
      OPT LIKE CTU_PARAMS,
      MSG TYPE I,
      VENUM TYPE I,
      VEPO TYPE I,
      INDEX TYPE I,
      DSTATUS TYPE C,
