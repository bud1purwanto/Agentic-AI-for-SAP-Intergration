      U_HU LIKE STANDARD TABLE OF IT_CHANGE WITH HEADER LINE,
      IT_BDCDATA    LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
      IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE,
      TBATCH LIKE STANDARD TABLE OF CLBATCH WITH HEADER LINE,
      REPORT LIKE STANDARD TABLE OF IT_REPORT WITH HEADER LINE,
      IT_GRADE LIKE STANDARD TABLE OF VTENTRIES WITH HEADER LINE,
      LS_REF1 TYPE REF TO CL_GUI_ALV_GRID,
      IT_CRITERIA LIKE STANDARD TABLE OF VTENTRIES WITH HEADER LINE.

